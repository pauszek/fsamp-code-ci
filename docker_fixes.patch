Subject: [PATCH] docker fixes
---
Index: .github/workflows/build-java.yml
IDEA additional info:
Subsystem: com.intellij.openapi.diff.impl.patch.CharsetEP
<+>UTF-8
===================================================================
diff --git a/.github/workflows/build-java.yml b/.github/workflows/build-java.yml
--- a/.github/workflows/build-java.yml	(revision 5fd2490f5c09ea29618bca5481f0dbef6389549c)
+++ b/.github/workflows/build-java.yml	(date 1767289252284)
@@ -81,6 +81,36 @@
         uses: actions/checkout@v5
         with:
           fetch-depth: 0
+      - name: Read schema version
+        id: schema
+        run: |
+          if [ -f schema.version ]; then
+            echo "version=$(tr -d '[:space:]' < schema.version)" >> "$GITHUB_OUTPUT"
+            echo "exists=true" >> "$GITHUB_OUTPUT"
+          else
+            echo "exists=false" >> "$GITHUB_OUTPUT"
+          fi
+      - name: Generate GitHub App Token
+        if: steps.schema.outputs.exists == 'true'
+        id: app-token
+        uses: actions/create-github-app-token@v1
+        with:
+          app-id: ${{ vars.GABRBA_APPID }}
+          private-key: ${{ secrets.GABRBA_SECRET }}
+      - name: Checkout event schema
+        if: steps.schema.outputs.exists == 'true'
+        uses: actions/checkout@v5
+        with:
+          repository: pauszek/fsamp-event-schema
+          path: schema-repo
+          ref: v${{ steps.schema.outputs.version }}
+          token: ${{ steps.app-token.outputs.token }}
+      - name: Setup schema directory
+        if: steps.schema.outputs.exists == 'true'
+        run: |
+          mkdir -p schema
+          cp schema-repo/event.schema.json schema/
+          echo "✅ Schema v${{ steps.schema.outputs.version }} ready"
       - name: Maven Build
         uses: pauszek/fsamp-code-ci/.github/actions/maven-build@main
         with:
